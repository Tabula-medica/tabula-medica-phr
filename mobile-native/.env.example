# ---------------------------------------------------------------------------
# Tabula Medica — native app environment (EXPO_PUBLIC_* are bundled into the
# client and are NOT secrets; they are safe to ship. NEVER put server secrets
# such as SESSION_SECRET or service-account keys here.)
# ---------------------------------------------------------------------------

# Live backend (Cloud Run). Same service behind both apex domains.
EXPO_PUBLIC_API_BASE_URL=https://tabulamedica.us

# Firebase / GCIP client config — mirrors the web client's VITE_GCIP_* values.
# Project: united-planet-485003-n7-9f345 (see server/auth/gcip.ts).
# Get these from the Firebase console > Project settings > Web app.
EXPO_PUBLIC_GCIP_API_KEY=
EXPO_PUBLIC_GCIP_AUTH_DOMAIN=
EXPO_PUBLIC_GCIP_PROJECT_ID=united-planet-485003-n7-9f345

# Google sign-in OAuth client IDs (Firebase console > Authentication > Google).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

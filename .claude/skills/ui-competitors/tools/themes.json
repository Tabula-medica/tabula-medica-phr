{
  "_about": "Themes reviews.py sorts competitor feedback into, tuned for patient-facing health apps. Patterns are Python regular expressions matched case-insensitively against review text. kind is complaint (something users hate) or request (something users want that is missing). Structure adapted from replica-skill (MIT); see ../THIRD_PARTY_NOTICES.md.",
  "request_patterns": [
    "\\bi wish\\b",
    "\\bplease add\\b",
    "\\bwould be (nice|great|good|helpful)\\b",
    "\\bwould love\\b",
    "\\bneeds? (a|an|the|to|more)\\b",
    "\\bno way to\\b",
    "\\bthere'?s no (way|option)\\b",
    "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off|share|download)\\b",
    "\\b(missing|lacks|lacking)\\b",
    "\\bdoesn'?t (have|support|let|allow)\\b",
    "\\bif only\\b",
    "\\bfeature request\\b",
    "\\bwhy (can'?t|isn'?t|doesn'?t)\\b"
  ],
  "themes": [
    {"id": "pricing", "label": "Price and paywalls", "kind": "complaint",
     "patterns": ["\\bexpensive\\b", "\\boverpriced\\b", "\\bpric(e|es|ey|ing)\\b", "\\bpaywall", "\\bsubscription\\b", "\\bper (month|year)\\b", "\\bfree (plan|tier|version|trial)\\b", "\\bupgrade to\\b", "\\bpremium\\b", "\\bnot worth\\b", "\\bpay to\\b"]},
    {"id": "billing", "label": "Billing, cancelling and refunds", "kind": "complaint",
     "patterns": ["\\bcharged\\b", "\\brefund", "\\bcancel(l?ing|l?ed|lation)?\\b", "\\bauto.?renew", "\\bhidden (fee|charge)", "\\bbilling\\b", "\\bscam\\b"]},
    {"id": "bugs", "label": "Bugs and crashes", "kind": "complaint",
     "patterns": ["\\bcrash(es|ed|ing)?\\b", "\\bbugs?\\b", "\\bbuggy\\b", "\\bglitch", "\\bfreez(e|es|ing)\\b", "\\bbroken\\b", "\\b(doesn'?t|does not|stopped) work", "\\bnot working\\b", "\\berror\\b"]},
    {"id": "performance", "label": "Slow, laggy, heavy", "kind": "complaint",
     "patterns": ["\\bslow\\b", "\\blag(gy|s)?\\b", "\\bloading\\b", "\\btakes forever\\b", "\\bbattery\\b", "\\bsluggish\\b"]},
    {"id": "sync", "label": "Sync, connection and lost data", "kind": "complaint",
     "patterns": ["\\bsync(ing|s|ed)?\\b", "\\blost (my|all)\\b", "\\bdisappear", "\\bdata loss\\b", "\\bwiped\\b", "\\bduplicat", "\\b(won'?t|can'?t|couldn'?t|failed to) (connect|link|pair)\\b", "\\bnot (showing|syncing|updating)\\b"]},
    {"id": "ux", "label": "Confusing or clunky to use", "kind": "complaint",
     "patterns": ["\\bconfus", "\\bhard to (use|find|navigate|understand|read)\\b", "\\bcomplicated\\b", "\\bcluttered\\b", "\\bunintuitive\\b", "\\bnot intuitive\\b", "\\bclunky\\b", "\\btoo many (steps|clicks|taps|screens|questions)\\b", "\\bcan'?t find\\b", "\\btext is (too )?small\\b"]},
    {"id": "support", "label": "Support that does not answer", "kind": "complaint",
     "patterns": ["\\bcustomer (service|support)\\b", "\\bsupport (team|is|was)\\b", "\\bno (response|reply)\\b", "\\bnever (replied|responded|heard back)\\b", "\\bticket\\b"]},
    {"id": "account", "label": "Login and account problems", "kind": "complaint",
     "patterns": ["\\blog ?in\\b", "\\bsign ?in\\b", "\\bpassword\\b", "\\blocked out\\b", "\\bverification\\b", "\\b2fa\\b", "\\bdelete (my )?account\\b", "\\bid (check|verification)\\b"]},
    {"id": "notifications", "label": "Notifications and reminders", "kind": "complaint",
     "patterns": ["\\bnotification", "\\bspam", "\\btoo many emails\\b", "\\bpush\\b", "\\breminders?\\b"]},
    {"id": "ads", "label": "Ads", "kind": "complaint",
     "patterns": ["\\bads\\b", "\\badvert", "\\bad.?supported\\b", "\\bpop.?ups?\\b"]},
    {"id": "updates", "label": "A redesign or update made it worse", "kind": "complaint",
     "patterns": ["\\b(new|latest|recent) (update|version|design)\\b", "\\bredesign", "\\bused to be\\b", "\\bbring back\\b", "\\bsince the update\\b"]},
    {"id": "privacy", "label": "Privacy, data sharing and permissions", "kind": "complaint",
     "patterns": ["\\bprivacy\\b", "\\btracking\\b", "\\bsell(s|ing)? (my )?data\\b", "\\bshar(es|ing|ed) (my )?(data|information|info)\\b", "\\bpermissions?\\b", "\\bcreepy\\b", "\\bhipaa\\b", "\\bthird part(y|ies)\\b"]},
    {"id": "ai-quality", "label": "AI answers wrong, generic or unsafe", "kind": "complaint",
     "patterns": ["\\b(ai|bot|chat ?bot|assistant)\\b.{0,60}\\b(wrong|useless|repeat|generic|robotic|canned|scripted|dumb|hallucinat)", "\\b(wrong|bad|dangerous|unsafe|inaccurate) (advice|answer|information|diagnosis)\\b", "\\bgave me (bad|wrong|incorrect)\\b", "\\bdoesn'?t (understand|remember)\\b", "\\bforgets?\\b", "\\bmade up\\b"]},
    {"id": "safety", "label": "Crisis handling and over-reliance", "kind": "complaint",
     "patterns": ["\\bcrisis\\b", "\\bsuicid", "\\bself.?harm\\b", "\\b988\\b", "\\bemergency\\b", "\\baddict", "\\bdepend(ent|ence)\\b", "\\binappropriate\\b", "\\bunsafe\\b"]},
    {"id": "language", "label": "Language and cultural fit", "kind": "complaint",
     "patterns": ["\\b(spanish|hindi|chinese|mandarin|tamil|telugu|punjabi|arabic|translation|translated)\\b", "\\bonly (in )?english\\b", "\\binterpreter\\b", "\\bnot (available|offered) in my language\\b"]},
    {"id": "cost-of-care", "label": "Cost, insurance and access to care", "kind": "complaint",
     "patterns": ["\\binsurance\\b", "\\bcopay\\b", "\\bdeductible\\b", "\\bout.of.pocket\\b", "\\buninsured\\b", "\\bnot covered\\b", "\\bin.network\\b"]},
    {"id": "records-import", "label": "Records, import and export", "kind": "request",
     "patterns": ["\\bimport\\b", "\\bexport\\b", "\\bdownload (my )?(records|data|results)\\b", "\\bpdf\\b", "\\bfhir\\b", "\\bepic\\b", "\\bmychart\\b", "\\blab (results|reports?)\\b", "\\bmedical records?\\b", "\\bpull (in|my)\\b"]},
    {"id": "integrations", "label": "Wearables and integrations", "kind": "request",
     "patterns": ["\\bapple (health|watch)\\b", "\\bfitbit\\b", "\\bgarmin\\b", "\\bgoogle fit\\b", "\\bhealth connect\\b", "\\bwearable", "\\bintegrat", "\\bapi\\b", "\\bcgm\\b", "\\bdexcom\\b", "\\bsmart ?watch\\b"]},
    {"id": "caregivers", "label": "Family, caregivers and proxies", "kind": "request",
     "patterns": ["\\bcaregiver", "\\bfamily (members?|accounts?|sharing)\\b", "\\bmy (mom|dad|mother|father|parents?|kids?|child(ren)?|son|daughter|husband|wife|spouse)\\b", "\\bproxy\\b", "\\bmultiple (profiles|people|users)\\b", "\\bon behalf of\\b"]},
    {"id": "platforms", "label": "Platforms, offline and accessibility", "kind": "request",
     "patterns": ["\\boffline\\b", "\\bandroid\\b", "\\bipad\\b", "\\btablet\\b", "\\bweb version\\b", "\\bdesktop\\b", "\\bscreen ?reader\\b", "\\bvoiceover\\b", "\\btalkback\\b", "\\bdark mode\\b", "\\bfont size\\b", "\\blarger text\\b"]},
    {"id": "customisation", "label": "Customisation and control", "kind": "request",
     "patterns": ["\\bcustomi[sz]", "\\btemplates?\\b", "\\boption to\\b", "\\bsettings?\\b", "\\bpersonali[sz]"]},
    {"id": "sharing", "label": "Sharing with providers", "kind": "request",
     "patterns": ["\\bshare (with|to) (my )?(doctor|provider|clinic|physician|specialist)\\b", "\\bsend (to|it to) (my )?(doctor|provider)\\b", "\\bqr\\b", "\\bvisit (summary|prep)\\b", "\\bappointment\\b"]}
  ]
}

{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.20.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": { "simulator": true, "resourceClass": "m-medium" },
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleDebug" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": false, "resourceClass": "m-medium", "autoIncrement": "buildNumber" },
      "android": { "buildType": "apk", "autoIncrement": "versionCode" }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "ios": { "resourceClass": "m-medium", "autoIncrement": "buildNumber" },
      "android": { "buildType": "app-bundle", "autoIncrement": "versionCode" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "TODO_FOUNDER_APPLE_ID_EMAIL",
        "ascAppId": "TODO_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "U56SKX5MXX"
      },
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}

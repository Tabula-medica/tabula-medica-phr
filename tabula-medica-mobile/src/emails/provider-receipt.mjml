<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Inter', 'Helvetica Neue', Arial, sans-serif" />
      <mj-text font-size="14px" color="#0f1923" line-height="22px" />
      <mj-button font-size="16px" font-weight="700" border-radius="10px" inner-padding="14px 28px" />
    </mj-attributes>
    <mj-style>
      .footer-link { color: #8fa3b8 !important; text-decoration: none; }
      .mono { font-family: 'SF Mono', 'Fira Code', monospace; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f8f7f4">

    <mj-section padding="30px 20px 10px">
      <mj-column>
        <mj-image src="https://uninsurance.org/logo.png" alt="Tabula Medica" width="180px" align="center" />
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="16px" padding="30px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="800" align="center" padding-bottom="6px">
          Provider Visit Receipt
        </mj-text>
        <mj-text font-size="12px" color="#8fa3b8" align="center" padding-bottom="20px">
          Uninsurance Network — Medicare Rate Payment
        </mj-text>

        <mj-divider border-color="#e2dfd8" border-width="1px" padding="0 0 20px" />

        <mj-text font-weight="700" font-size="13px" color="#8fa3b8" text-transform="uppercase" letter-spacing="1px" padding-bottom="8px">
          Visit Summary
        </mj-text>

        <mj-table>
          <tr>
            <td style="padding: 8px 0; color: #8fa3b8; font-size: 13px;">Provider</td>
            <td style="padding: 8px 0; font-weight: 600; text-align: right;">{{providerName}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #8fa3b8; font-size: 13px;">NPI</td>
            <td style="padding: 8px 0; font-weight: 600; text-align: right; font-family: monospace;">{{providerNPI}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #8fa3b8; font-size: 13px;">Patient</td>
            <td style="padding: 8px 0; font-weight: 600; text-align: right;">{{patientName}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #8fa3b8; font-size: 13px;">Visit Date</td>
            <td style="padding: 8px 0; font-weight: 600; text-align: right;">{{visitDate}}</td>
          </tr>
        </mj-table>

        <mj-divider border-color="#e2dfd8" border-width="1px" padding="16px 0" />

        <mj-text font-weight="700" font-size="13px" color="#8fa3b8" text-transform="uppercase" letter-spacing="1px" padding-bottom="12px">
          Services Rendered
        </mj-text>

        <mj-table>
          <tr style="border-bottom: 1px solid #e2dfd8;">
            <td style="padding: 10px 0; font-weight: 700; font-size: 12px; color: #8fa3b8;">CPT</td>
            <td style="padding: 10px 0; font-weight: 700; font-size: 12px; color: #8fa3b8;">Service</td>
            <td style="padding: 10px 0; font-weight: 700; font-size: 12px; color: #8fa3b8; text-align: right;">Amount</td>
          </tr>
          {{#each lineItems}}
          <tr style="border-bottom: 1px solid #f3f4f6;">
            <td style="padding: 8px 0; font-family: monospace; font-size: 12px;">{{this.cptCode}}</td>
            <td style="padding: 8px 0; font-size: 12px;">{{this.description}}</td>
            <td style="padding: 8px 0; font-size: 12px; text-align: right; font-weight: 600;">${{this.amount}}</td>
          </tr>
          {{/each}}
          <tr>
            <td colspan="2" style="padding: 12px 0; font-weight: 800; font-size: 14px;">Total</td>
            <td style="padding: 12px 0; font-weight: 800; font-size: 18px; text-align: right; color: #0d9e8a;">${{totalAmount}}</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="16px" padding="24px">
      <mj-column>
        <mj-text font-weight="700" font-size="13px" color="#8fa3b8" text-transform="uppercase" letter-spacing="1px" padding-bottom="8px">
          Payment Details
        </mj-text>

        <mj-table>
          <tr>
            <td style="padding: 6px 0; color: #8fa3b8; font-size: 12px;">Payment Lane</td>
            <td style="padding: 6px 0; font-weight: 600; font-size: 12px; text-align: right;">
              {{#isLaneA}}Lane A — Self-Pay (InstaMed){{/isLaneA}}
              {{#isLaneB}}Lane B — VA Community Care (Optum CCN){{/isLaneB}}
            </td>
          </tr>
          {{#isLaneA}}
          <tr>
            <td style="padding: 6px 0; color: #8fa3b8; font-size: 12px;">Transaction ID</td>
            <td style="padding: 6px 0; font-weight: 600; font-size: 12px; text-align: right; font-family: monospace;">{{transactionId}}</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; color: #8fa3b8; font-size: 12px;">Settlement</td>
            <td style="padding: 6px 0; font-weight: 600; font-size: 12px; text-align: right;">24-hour ACH</td>
          </tr>
          {{/isLaneA}}
          {{#isLaneB}}
          <tr>
            <td style="padding: 6px 0; color: #8fa3b8; font-size: 12px;">VA Referral</td>
            <td style="padding: 6px 0; font-weight: 600; font-size: 12px; text-align: right; font-family: monospace;">{{vaReferralNumber}}</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; color: #8fa3b8; font-size: 12px;">Payer</td>
            <td style="padding: 6px 0; font-weight: 600; font-size: 12px; text-align: right;">Optum CCN (VACCN)</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; color: #8fa3b8; font-size: 12px;">Patient Responsibility</td>
            <td style="padding: 6px 0; font-weight: 800; font-size: 14px; text-align: right; color: #15803d;">$0.00</td>
          </tr>
          {{/isLaneB}}
          <tr>
            <td style="padding: 6px 0; color: #8fa3b8; font-size: 12px;">GFE ID</td>
            <td style="padding: 6px 0; font-weight: 600; font-size: 12px; text-align: right; font-family: monospace;">{{gfeId}}</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f3f4f6" border-radius="14px" padding="20px 24px">
      <mj-column>
        <mj-text font-size="11px" color="#4a5568" line-height="17px">
          <strong>Dispute Rights (No Surprises Act):</strong> If the final charge exceeds the Good Faith Estimate by $400 or more, you may dispute the bill within 120 calendar days. Visit cms.gov/nosurprises or call 1-800-985-3059.
        </mj-text>
        <mj-text font-size="11px" color="#4a5568" line-height="17px" padding-top="8px">
          <strong>HSA/FSA:</strong> {{#hsaEligible}}This visit qualifies for HSA/FSA reimbursement.{{/hsaEligible}}{{^hsaEligible}}Consult your tax advisor for HSA/FSA eligibility.{{/hsaEligible}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="10px 20px 30px">
      <mj-column>
        <mj-text font-size="10px" color="#8fa3b8" align="center" line-height="16px">
          Tabula Medica, Inc. DBA Uninsurance<br/>
          This receipt is for your records. Keep it for tax purposes if paying with HSA/FSA.<br/>
          <a href="https://uninsurance.org/privacy" class="footer-link">Privacy Policy</a> · <a href="mailto:billing@tabulamedica.health" class="footer-link">Billing Questions</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>

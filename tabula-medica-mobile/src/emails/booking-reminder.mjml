<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Inter', 'Helvetica Neue', Arial, sans-serif" />
      <mj-text font-size="14px" color="#0f1923" line-height="22px" />
      <mj-button font-size="16px" font-weight="700" border-radius="10px" inner-padding="14px 28px" />
    </mj-attributes>
    <mj-style>
      .footer-link { color: #8fa3b8 !important; text-decoration: none; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f8f7f4">

    <mj-section padding="30px 20px 10px">
      <mj-column>
        <mj-image src="https://uninsurance.org/logo.png" alt="Tabula Medica Uninsurance" width="180px" align="center" />
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="16px" padding="30px 24px">
      <mj-column>
        <mj-text font-size="28px" align="center" padding-bottom="8px">
          📋
        </mj-text>
        <mj-text font-size="20px" font-weight="800" align="center" padding-bottom="6px">
          Appointment Reminder
        </mj-text>
        <mj-text font-size="14px" color="#4a5568" align="center" padding-bottom="24px">
          Your appointment is {{reminderWindow}} — here's what you need to know.
        </mj-text>

        <mj-divider border-color="#e2dfd8" border-width="1px" padding="0 0 20px" />

        <mj-table>
          <tr>
            <td style="padding: 10px 0; color: #8fa3b8; font-size: 13px;">When</td>
            <td style="padding: 10px 0; font-weight: 700; font-size: 15px; text-align: right;">{{appointmentDate}} at {{appointmentTime}}</td>
          </tr>
          <tr>
            <td style="padding: 10px 0; color: #8fa3b8; font-size: 13px;">Where</td>
            <td style="padding: 10px 0; font-weight: 600; text-align: right;">{{providerName}}</td>
          </tr>
          <tr>
            <td style="padding: 10px 0; color: #8fa3b8; font-size: 13px;">Address</td>
            <td style="padding: 10px 0; font-weight: 600; text-align: right;">{{providerAddress}}</td>
          </tr>
          <tr>
            <td style="padding: 10px 0; color: #8fa3b8; font-size: 13px;">Service</td>
            <td style="padding: 10px 0; font-weight: 600; text-align: right;">{{serviceName}} ({{cptCode}})</td>
          </tr>
          <tr>
            <td style="padding: 10px 0; color: #8fa3b8; font-size: 13px;">Your Price</td>
            <td style="padding: 10px 0; font-weight: 800; font-size: 18px; text-align: right; color: #0d9e8a;">
              {{#isLaneA}}${{medicareRate}}{{/isLaneA}}
              {{#isLaneB}}$0.00 (VA pays){{/isLaneB}}
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="16px" padding="24px">
      <mj-column>
        <mj-text font-weight="800" font-size="15px" padding-bottom="12px">
          ✅ Checklist — What to Bring
        </mj-text>

        <mj-text font-size="13px" color="#4a5568" line-height="24px">
          ☐ Photo ID (any government-issued ID — passport, driver's license, consular ID, school ID)<br/>
          {{#isLaneA}}☐ Payment method — credit/debit card, HSA/FSA card, or AaNeel NFC card<br/>{{/isLaneA}}
          {{#isLaneB}}☐ VA referral number: <strong>{{vaReferralNumber}}</strong><br/>{{/isLaneB}}
          ☐ List of current medications (or take a photo of your pill bottles)<br/>
          ☐ Any recent lab results or imaging reports<br/>
          ☐ This email or your Tabula Medica app for check-in
        </mj-text>
      </mj-column>
    </mj-section>

    {{#isLaneA}}
    <mj-section background-color="rgba(13,158,138,0.08)" border-radius="14px" padding="20px 24px">
      <mj-column>
        <mj-text font-size="13px" font-weight="700" color="#0d9e8a" padding-bottom="6px">
          💰 Payment Tip
        </mj-text>
        <mj-text font-size="12px" color="#4a5568" line-height="18px">
          Pay with your HSA or FSA card to save on taxes. Your visit at ${{medicareRate}} (CPT {{cptCode}}) is a qualified medical expense under IRS Publication 502.
        </mj-text>
      </mj-column>
    </mj-section>
    {{/isLaneA}}

    {{#isLaneB}}
    <mj-section background-color="rgba(245,158,11,0.08)" border-radius="14px" padding="20px 24px">
      <mj-column>
        <mj-text font-size="13px" font-weight="700" color="#b45309" padding-bottom="6px">
          🎖️ VA Community Care Note
        </mj-text>
        <mj-text font-size="12px" color="#92400e" line-height="18px">
          Present your VA referral number at check-in. The provider will bill Optum CCN directly — you owe $0. If you have questions about your referral, call the VA Health Benefits Hotline at 1-877-222-8387.
        </mj-text>
      </mj-column>
    </mj-section>
    {{/isLaneB}}

    <mj-section padding="16px 20px">
      <mj-column width="50%">
        <mj-button background-color="#0d9e8a" href="{{appDeepLink}}">
          Open in App
        </mj-button>
      </mj-column>
      <mj-column width="50%">
        <mj-button background-color="#ffffff" color="#0f1923" border="1px solid #e2dfd8" href="{{directionsUrl}}">
          Get Directions
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f3f4f6" border-radius="14px" padding="16px 24px">
      <mj-column>
        <mj-text font-size="13px" font-weight="700" color="#0f1923" padding-bottom="6px">
          Need to reschedule or cancel?
        </mj-text>
        <mj-text font-size="12px" color="#4a5568" line-height="18px">
          Open the Tabula Medica app → My Appointments → tap this visit to reschedule or cancel. You can also call the provider directly at {{providerPhone}}.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="10px 20px 30px">
      <mj-column>
        <mj-text font-size="10px" color="#8fa3b8" align="center" line-height="16px">
          Tabula Medica, Inc. DBA Uninsurance<br/>
          GFE ID: {{gfeId}} — keep this for your records.<br/>
          <a href="https://uninsurance.org/privacy" class="footer-link">Privacy Policy</a> · <a href="https://uninsurance.org/terms" class="footer-link">Terms</a> · <a href="mailto:support@tabulamedica.health" class="footer-link">Support</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>

API_BASE_URL=https://api.tabulamedica.digital
FHIR_REDIRECT_SCHEME=tabulamedica

# Firebase / Google Cloud Identity Platform (same project as the web client).
# The backend (server/auth/gcip.ts) verifies tokens against issuer
# https://securetoken.google.com/<projectId> with audience <projectId>.
EXPO_PUBLIC_GCIP_API_KEY=
EXPO_PUBLIC_GCIP_AUTH_DOMAIN=
EXPO_PUBLIC_GCIP_PROJECT_ID=

# Google sign-in (mirrors the web client's signInGcipWithGoogle flow).
# Create per-platform OAuth client IDs in the Firebase / GCP console.
# Leave blank to hide the "Continue with Google" button on the login screen.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
